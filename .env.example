# ---------------------------------------------------------------------------
# Copie este arquivo para .env.local (uso na sua maquina) ou cadastre estas
# variaveis no painel da Vercel (Settings > Environment Variables).
# ---------------------------------------------------------------------------

# --- Senha de acesso (recomendado) -----------------------------------------
# Quem abrir o link precisa digitar esta senha. Sem ela, o link fica aberto
# para qualquer pessoa da internet.
SENHA_ACESSO=troque-esta-senha

# Opcional. Se nao preencher, a assinatura do cookie e derivada da senha.
# SEGREDO_SESSAO=uma-frase-longa-e-aleatoria

# --- Provedor de transcricao ------------------------------------------------
# "azure-speech" (padrao, recomendado) ou "azure-openai-whisper".
PROVEDOR_TRANSCRICAO=azure-speech

# --- Azure AI Speech (usado pelo provedor padrao) ---------------------------
# Em "Chaves e Ponto de Extremidade" do recurso de Fala, no portal da Azure.
# Pode colar o endpoint completo ou so o nome do recurso.
AZURE_SPEECH_ENDPOINT=https://SEU-RECURSO.cognitiveservices.azure.com
AZURE_SPEECH_KEY=cole-aqui-a-chave

# Opcional. Padrao: pt-BR
# AZURE_SPEECH_LOCALE=pt-BR

# --- Azure OpenAI Whisper (so se PROVEDOR_TRANSCRICAO=azure-openai-whisper) --
# AZURE_OPENAI_ENDPOINT=https://SEU-RECURSO.openai.azure.com
# AZURE_OPENAI_KEY=cole-aqui-a-chave
# AZURE_OPENAI_WHISPER_DEPLOYMENT=nome-da-implantacao
# AZURE_OPENAI_API_VERSION=2024-06-01

# --- Tamanho maximo por arquivo, em MB ---------------------------------------
# Padrao: 4 (limite da Vercel). No Azure App Service pode subir bem mais,
# porque la nao existe o teto de corpo de requisicao.
# TAMANHO_MAXIMO_MB=25
